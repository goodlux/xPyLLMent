# xPyLLMent Environment Variables

# API Keys (REQUIRED)
# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative: OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=asi_arch_research
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# MongoDB Configuration (alternative)
MONGODB_URL=mongodb://localhost:27017/asi_arch_research

# Pixeltable Configuration
PIXELTABLE_CONFIG_PATH=./pixeltable_config.yaml

# Research Configuration
RESEARCH_DATA_DIR=./research_data
SNAPSHOTS_DIR=./snapshots
LOGS_DIR=./logs

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ARCH_LIST="8.0;8.6"

# Development Settings
DEBUG=false
LOG_LEVEL=INFO
ENABLE_TELEMETRY=false

# Optional: Weights & Biases for experiment tracking
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=asi-arch-research

# Optional: HuggingFace for model hub access
# HUGGINGFACE_TOKEN=your_hf_token
